{
    "name": "ambrosethebuild/simple-chat",
    "description": "A flexible Laravel chat package with support for sharded SQLite, Eloquent, and Appwrite backends.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SimpleChat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimpleChat\\SimpleChatServiceProvider"
            ],
            "aliases": {
                "SimpleChat": "SimpleChat\\Facades\\SimpleChat"
            }
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0"
    }
}